# ============================================
# AliağaAI - Environment Variables Template
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# cp .env.example .env

# ── Database (PostgreSQL + pgvector) ─────────────────
DATABASE_URL=postgresql+asyncpg://aliagai:aliagai_secret@localhost:5432/aliagai_db

# ── AI - Groq (ücretsiz tier) ───────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_DEFAULT_MAX_TOKENS=2048
LLM_MAX_RETRIES=2

# ── API Auth ──────────────────────────────────────
API_KEY=your_api_key_here
AUTH_ENABLED=true

# ── AI - OpenAI (birincil / fallback yapisi) ────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RAG_GROUNDED_MAX_TOKENS=2600
RAG_AUGMENTATION_MAX_TOKENS=1600
RAG_MODEL_FALLBACK_MAX_TOKENS=1800
PERSONA_MAX_TOKENS=2200

# ── Agentic RAG ────────────────────────────────────
AGENT_MAX_TOKENS=3000
AGENT_TEMPERATURE=0.35
AGENT_MAX_TOOL_ROUNDS=3

# ── Embedding Model ─────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_QUERY_EMBED_TIMEOUT_SEC=20.0

# ── CollectAPI ─────────────────────────────────────
COLLECTAPI_KEY=your_collectapi_key_here

# ── Scraper ───────────────────────────────────────
SCRAPE_TIMEOUT=30
USER_AGENT=AliagaAI/1.0 (Educational Project)

# ── Environment ──────────────────────────────────────
ENV=development
DEBUG=true
# RAG tuning
RAG_TOP_K=10
RAG_MIN_SIMILARITY=0.35
RAG_VECTOR_CANDIDATES=60
RAG_LEXICAL_CANDIDATES=60
RAG_VECTOR_WEIGHT=0.70
RAG_LEXICAL_WEIGHT=0.30
RAG_RERANK_ENABLED=true
RAG_RERANK_TOP_N=20
RAG_QUERY_EXPANSION_ENABLED=true
RAG_MAX_QUERY_VARIANTS=4
RAG_SHORT_QUERY_MIN_SIMILARITY=0.28
RAG_MEDIUM_QUERY_MIN_SIMILARITY=0.30
RAG_LEXICAL_RESCUE_SCORE=0.40
RAG_MIN_EVIDENCE_CONFIDENCE=0.20
RAG_MIN_EVIDENCE_CHUNKS=1
RAG_ENABLE_CONTROLLED_AUGMENTATION=true
RAG_ENABLE_MODEL_ONLY_FALLBACK=true
RAG_MODEL_ONLY_BASE_CONFIDENCE=0.35
RAG_AUGMENTATION_MIN_EVIDENCE=0.35
RAG_PARALLEL_RETRIEVAL_ENABLED=true
RAG_SKIP_VECTOR_WHEN_SQL_HIT=true
RAG_CONTEXT_SNIPPET_CHARS=1800
PERSONA_ENABLED=true
PERSONA_TEMPERATURE=0.20

# Embedding runtime
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=16

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=120
CHUNK_MIN_LENGTH=80
EMBEDDING_RETRY_COOLDOWN_SEC=60

# Docker Compose defaults
POSTGRES_USER=aliagai
POSTGRES_PASSWORD=aliagai_secret
POSTGRES_DB=aliagai_db
DNS_SERVER_1=8.8.8.8
DNS_SERVER_2=8.8.4.4

# Frontend (Expo web)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Startup behavior
# NOT: Docker'da STARTUP_SEED_RAG_CHUNKS_ENABLED varsayılan olarak false'tur
# (seed dosyası container'da bulunmayabilir). Lokal geliştirmede true önerilir.
STARTUP_SEED_RAG_CHUNKS_ENABLED=true
STARTUP_BACKGROUND_JOBS_ENABLED=true
STARTUP_EMBEDDING_WARMUP_ENABLED=true
